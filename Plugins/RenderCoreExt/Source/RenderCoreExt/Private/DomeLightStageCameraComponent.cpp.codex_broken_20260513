FLinearColor UDomeLightStageCameraComponent::ComputeVertexSemanticColor(
    int32 VertIdx,
    const FSkinWeightVertexBuffer* SkinWeights,
    const FReferenceSkeleton& RefSkel,
    int32 NumInfluences) const
{
    FLinearColor BlendedColor = FLinearColor::Black;
    float TotalWeight = 0.0f;

    for (int32 Inf = 0; Inf < NumInfluences; ++Inf)
    {
        uint16 BoneIdx    = SkinWeights->GetBoneIndex(VertIdx, Inf);
        uint16 RawWeight  = SkinWeights->GetBoneWeight(VertIdx, Inf);
        float  Weight     = (float)RawWeight / 65535.0f;

        if (Weight < KINDA_SMALL_NUMBER) break; // 权重已排序降序，后续均为 0

        FName   BoneName  = RefSkel.GetBoneName(BoneIdx);
        FLinearColor BoneColor = ResolveBoneSemanticColor(BoneName.ToString());

        BlendedColor += BoneColor * Weight;
        TotalWeight  += Weight;
    }

    if (TotalWeight > KINDA_SMALL_NUMBER)
        BlendedColor /= TotalWeight;
    else
        BlendedColor = GSemanticDefaultColor;

    // 钳制到 [0,1]，避免 HDR 超出范围
    BlendedColor.R = FMath::Clamp(BlendedColor.R, 0.0f, 1.0f);
    BlendedColor.G = FMath::Clamp(BlendedColor.G, 0.0f, 1.0f);
    BlendedColor.B = FMath::Clamp(BlendedColor.B, 0.0f, 1.0f);
    BlendedColor.A = 1.0f;
    return BlendedColor;
}

// ─── ResolveBoneSemanticColor ─────────────────────────────────────────────────

FLinearColor UDomeLightStageCameraComponent::ResolveBoneSemanticColor(const FString& BoneName) const
{
    // Pass 1：精确匹配（完整骨骼名）
    for (const FBoneSemanticEntry& Entry : GBoneSemanticMap)
    {
        if (BoneName.Equals(Entry.BonePrefix, ESearchCase::IgnoreCase))
            return Entry.Color;
    }
    // Pass 2：前缀匹配（覆盖 index_01_l / index_02_l / index_03_l 等多节指骨）
    for (const FBoneSemanticEntry& Entry : GBoneSemanticMap)
    {
        if (BoneName.StartsWith(Entry.BonePrefix, ESearchCase::IgnoreCase))
            return Entry.Color;
    }
    return GSemanticDefaultColor;
}

// ─── CreateSemanticMIDForMesh ─────────────────────────────────────────────────

UMaterialInstanceDynamic* UDomeLightStageCameraComponent::CreateSemanticMIDForMesh(
    UTexture2D* SemanticTex, USkeletalMeshComponent* SkelComp) const
{
    if (!SemanticTex) return nullptr;

    UMaterialInterface* BaseMat = nullptr;

    // 优先使用用户指定的基础材质（含 "SemanticMap" 参数的 Unlit 材质）
    if (!SemanticBaseMaterialPath.IsEmpty())
    {
        BaseMat = LoadObject<UMaterialInterface>(nullptr, *SemanticBaseMaterialPath);
    }

#if WITH_EDITORONLY_DATA
    // 编辑器模式：自动创建一个含 Texture Sample 参数的临时 Unlit 材质
    if (!BaseMat)
    {
        UMaterial* AutoMat = NewObject<UMaterial>(
            GetTransientPackage(),
            *FString::Printf(TEXT("M_SemanticBase_%s"), *SkelComp->GetName()),
            RF_Transient);

        AutoMat->MaterialDomain = MD_Surface;
        AutoMat->BlendMode      = BLEND_Opaque;
        AutoMat->SetShadingModel(MSM_Unlit);
        AutoMat->bUsedWithSkeletalMesh = true;

        // 添加 TextureSampleParameter2D 节点，参数名 "SemanticMap"
        UMaterialExpressionTextureSampleParameter2D* TexParam =
            NewObject<UMaterialExpressionTextureSampleParameter2D>(AutoMat);
        TexParam->ParameterName = TEXT("SemanticMap");
        TexParam->Texture       = SemanticTex;

        AutoMat->GetExpressionCollection().AddExpression(TexParam);
        AutoMat->GetEditorOnlyData()->BaseColor.Expression = TexParam;
        AutoMat->GetEditorOnlyData()->EmissiveColor.Expression = TexParam;
        AutoMat->PostEditChange();

        BaseMat = AutoMat;
    }
#endif

    if (!BaseMat)
    {
        UE_LOG(LogTemp, Error,
            TEXT("[DomeLightStage] CreateSemanticMIDForMesh: no base material available. "
                 "Set SemanticBaseMaterialPath or use an editor build."));
        return nullptr;
    }

    UMaterialInstanceDynamic* MID = UMaterialInstanceDynamic::Create(BaseMat, GetTransientPackage());
    if (MID)
        MID->SetTextureParameterValue(TEXT("SemanticMap"), SemanticTex);

    return MID;
}

// ─── RenderSemanticWithWeightCache ────────────────────────────────────────────

void UDomeLightStageCameraComponent::RenderSemanticWithWeightCache(
    int32 ProbeIdx, UTextureRenderTarget2D* TargetRT, const FString& OutputPath)
{
    if (!TargetRT || !ProbeCaptures.IsValidIndex(ProbeIdx)) return;
    USceneCaptureComponent2D* Cap = ProbeCaptures[ProbeIdx];
    if (!Cap) return;

    // ── Step 1：收集需要替换的 SkelComp 并暂存原始材质 ──────────────────────
    struct FRestoreEntry
    {
        TWeakObjectPtr<USkeletalMeshComponent> SkelComp;
        TArray<UMaterialInterface*>            OrigMaterials;
    };
    TArray<FRestoreEntry>         RestoreList;
    TArray<USkeletalMeshComponent*> ActiveComps;

    for (auto& Pair : SemanticCache)
    {
        USkeletalMeshComponent* SkelComp = Pair.Key.Get();
        if (!SkelComp || !SkelComp->IsRegistered()) continue;

        FSemanticMeshEntry& Entry = Pair.Value;
        if (!Entry.SemanticMID) continue;

        FRestoreEntry Restore;
        Restore.SkelComp = SkelComp;
        const int32 NumMats = SkelComp->GetNumMaterials();
        Restore.OrigMaterials.Reserve(NumMats);

        for (int32 MatIdx = 0; MatIdx < NumMats; ++MatIdx)
        {
            Restore.OrigMaterials.Add(SkelComp->GetMaterial(MatIdx));
            SkelComp->SetMaterial(MatIdx, Entry.SemanticMID);
        }

        RestoreList.Add(MoveTemp(Restore));
        ActiveComps.Add(SkelComp);
    }

    if (ActiveComps.Num() == 0)
    {
        UE_LOG(LogTemp, Warning, TEXT("[DomeLightStage] RenderSemanticWithWeightCache: no active cached components."));
        return;
    }

    // ── Step 2：配置 Capture Pass（无光照，无 AA，纯色输出）──────────────────
    UTextureRenderTarget2D*      OrigRT          = Cap->TextureTarget;
    FPostProcessSettings         OrigPPS         = Cap->PostProcessSettings;
    ESceneCaptureSource          OrigSrc         = Cap->CaptureSource;
    FEngineShowFlags             OrigFlags       = Cap->ShowFlags;
    ESceneCapturePrimitiveRenderMode OrigMode    = Cap->PrimitiveRenderMode;

    Cap->TextureTarget  = TargetRT;
    Cap->CaptureSource  = ESceneCaptureSource::SCS_FinalColorLDR;
    Cap->PostProcessSettings.WeightedBlendables.Array.Empty();
    if (UWorld* World = GetWorld())
    {
        UKismetRenderingLibrary::ClearRenderTarget2D(World, TargetRT, FLinearColor::Black);
    }

    // 只渲染缓存中的 SkeletalMeshComponent
    Cap->PrimitiveRenderMode = ESceneCapturePrimitiveRenderMode::PRM_UseShowOnlyList;
    Cap->ClearShowOnlyComponents();
    for (USkeletalMeshComponent* SkelComp : ActiveComps)
        Cap->ShowOnlyComponent(SkelComp);

    // 关闭所有影响颜色准确性的效果
    Cap->ShowFlags.SetLighting(false);
    Cap->ShowFlags.SetSkyLighting(false);
    Cap->ShowFlags.SetAtmosphere(false);
    Cap->ShowFlags.SetFog(false);
    Cap->ShowFlags.SetVolumetricFog(false);
    Cap->ShowFlags.SetCloud(false);
    Cap->ShowFlags.SetPostProcessing(false);
    Cap->ShowFlags.SetTemporalAA(false);
    Cap->ShowFlags.SetAntiAliasing(false);
    Cap->ShowFlags.SetMotionBlur(false);
    Cap->ShowFlags.SetBloom(false);
    Cap->ShowFlags.SetEyeAdaptation(false);
    Cap->ShowFlags.SetGrain(false);
    Cap->ShowFlags.SetVignette(false);

    // ── Step 3：捕获 + 导出 ─────────────────────────────────────────────────
    Cap->CaptureScene();
    FlushRenderingCommands();

    FImageWriteOptions Opts;
    Opts.Format = EDesiredImageFormat::PNG;
    Opts.bAsync = false;
    UImageWriteBlueprintLibrary::ExportToDisk(TargetRT, OutputPath, Opts);

    // ── Step 4：还原所有材质和捕获状态 ──────────────────────────────────────
    Cap->ClearShowOnlyComponents();
    Cap->PrimitiveRenderMode = OrigMode;
    Cap->TextureTarget       = OrigRT;
    Cap->PostProcessSettings = OrigPPS;
    Cap->CaptureSource       = OrigSrc;
    Cap->ShowFlags           = OrigFlags;

    for (const FRestoreEntry& Restore : RestoreList)
    {
        if (USkeletalMeshComponent* SkelComp = Restore.SkelComp.Get())
        {
            for (int32 MatIdx = 0; MatIdx < Restore.OrigMaterials.Num(); ++MatIdx)
                SkelComp->SetMaterial(MatIdx, Restore.OrigMaterials[MatIdx]);
        }
    }
}

// =============================================================================
// ── SEMANTIC：通用入口 + 兜底路径 ─────────────────────────────────────────────
// =============================================================================

void UDomeLightStageCameraComponent::RenderAndExportSemantic(
    int32 ProbeIdx, UTextureRenderTarget2D* TargetRT, const FString& OutputPath)
{
    if (!TargetRT || !ProbeCaptures.IsValidIndex(ProbeIdx)) return;

    if (SemanticCache.Num() > 0)
    {
        RenderSemanticWithWeightCache(ProbeIdx, TargetRT, OutputPath);
        return;
    }

    if (FisheyeSemanticPostProcessMaterial)
    {
        RenderAndExportAOV(ProbeIdx, FisheyeSemanticPostProcessMaterial, TargetRT, OutputPath, false, true);
        return;
    }

    // 优先级 3：兜底 - 槽级材质替换（粗粒度，原有逻辑保留）
    UE_LOG(LogTemp, Warning,
        TEXT("[DomeLightStage] Semantic: falling back to slot-level material replacement. "
             "Call ConfigureDome or RebuildSemanticTextureCache to enable fine-grained mode."));

    EnsureSemanticRegionMaterials();
    if (SemanticRegionMaterials.Num() == 0)
    {
        UE_LOG(LogTemp, Error, TEXT("[DomeLightStage] Semantic pass skipped: no materials available."));
        return;
    }

    UWorld* World = GetWorld();
    USceneCaptureComponent2D* Cap = ProbeCaptures[ProbeIdx];
    if (!World || !Cap) return;

    struct FMeshMaterialRestore
    {
        TWeakObjectPtr<UMeshComponent> Mesh;
        TArray<UMaterialInterface*>    Materials;
    };

    TArray<FMeshMaterialRestore> RestoreMaterials;
    TArray<UMeshComponent*>      SemanticMeshes;

    for (TActorIterator<AActor> ActorIt(World); ActorIt; ++ActorIt)
    {
        TArray<UMeshComponent*> Meshes;
        ActorIt->GetComponents<UMeshComponent>(Meshes);
        for (UMeshComponent* MeshComp : Meshes)
        {
            if (!IsSemanticCandidateMesh(MeshComp)) continue;

            FMeshMaterialRestore Restore;
            Restore.Mesh = MeshComp;
            const int32 NumMaterials = MeshComp->GetNumMaterials();
            Restore.Materials.Reserve(NumMaterials);

            for (int32 MatIdx = 0; MatIdx < NumMaterials; ++MatIdx)
            {
                Restore.Materials.Add(MeshComp->GetMaterial(MatIdx));
                FName Region = GetSemanticRegionForMeshSlot(MeshComp, MatIdx);
                UMaterialInterface* const* RegionMat = SemanticRegionMaterials.Find(Region);
                MeshComp->SetMaterial(MatIdx,
                    RegionMat ? *RegionMat : SemanticRegionMaterials.FindRef(TEXT("Body")));
            }
            RestoreMaterials.Add(MoveTemp(Restore));
            SemanticMeshes.Add(MeshComp);
        }
    }

    UTextureRenderTarget2D*      OrigRT   = Cap->TextureTarget;
    FPostProcessSettings         OrigPPS  = Cap->PostProcessSettings;
    ESceneCaptureSource          OrigSrc  = Cap->CaptureSource;
    FEngineShowFlags             OrigFlags = Cap->ShowFlags;
    ESceneCapturePrimitiveRenderMode OrigMode = Cap->PrimitiveRenderMode;

    Cap->TextureTarget  = TargetRT;
    Cap->CaptureSource  = ESceneCaptureSource::SCS_FinalColorLDR;
    Cap->PostProcessSettings.WeightedBlendables.Array.Empty();
    Cap->PrimitiveRenderMode = ESceneCapturePrimitiveRenderMode::PRM_UseShowOnlyList;
    Cap->ClearShowOnlyComponents();
    for (UMeshComponent* MeshComp : SemanticMeshes) Cap->ShowOnlyComponent(MeshComp);

    Cap->ShowFlags.SetLighting(false);
    Cap->ShowFlags.SetPostProcessing(false);
    Cap->ShowFlags.SetTemporalAA(false);
    Cap->ShowFlags.SetAntiAliasing(false);
    Cap->ShowFlags.SetMotionBlur(false);
    Cap->ShowFlags.SetBloom(false);
    Cap->ShowFlags.SetEyeAdaptation(false);
    Cap->ShowFlags.SetGrain(false);
    Cap->ShowFlags.SetVignette(false);

    Cap->CaptureScene();
    FlushRenderingCommands();

    FImageWriteOptions Opts;
    Opts.Format = EDesiredImageFormat::PNG;
    Opts.bAsync = false;
    UImageWriteBlueprintLibrary::ExportToDisk(TargetRT, OutputPath, Opts);

    Cap->ClearShowOnlyComponents();
    Cap->PrimitiveRenderMode = OrigMode;
    Cap->TextureTarget       = OrigRT;
    Cap->PostProcessSettings = OrigPPS;
    Cap->CaptureSource       = OrigSrc;
    Cap->ShowFlags           = OrigFlags;

    for (const FMeshMaterialRestore& Restore : RestoreMaterials)
    {
        if (UMeshComponent* MeshComp = Restore.Mesh.Get())
        {
            for (int32 MatIdx = 0; MatIdx < Restore.Materials.Num(); ++MatIdx)
                MeshComp->SetMaterial(MatIdx, Restore.Materials[MatIdx]);
        }
    }
}

