UMaterialInterface* UDomeLightStageCameraComponent::CreateSemanticColorMaterial(
    const FName& RegionName, const FLinearColor& Color)
{
#if WITH_EDITORONLY_DATA
    UMaterial* Material = NewObject<UMaterial>(
        GetTransientPackage(),
        *FString::Printf(TEXT("M_Semantic_%s"), *RegionName.ToString()),
        RF_Transient);
    if (!Material) return nullptr;

    Material->MaterialDomain = MD_Surface;
    Material->BlendMode      = BLEND_Opaque;
    Material->SetShadingModel(MSM_Unlit);
    Material->bUsedWithSkeletalMesh = true;

    UMaterialExpressionConstant3Vector* ColorExpr = NewObject<UMaterialExpressionConstant3Vector>(Material);
    ColorExpr->Constant = Color;
    Material->GetExpressionCollection().AddExpression(ColorExpr);
    Material->GetEditorOnlyData()->EmissiveColor.Expression = ColorExpr;
    Material->GetEditorOnlyData()->BaseColor.Expression     = ColorExpr;
    Material->PostEditChange();
    return Material;
#else
    UE_LOG(LogTemp, Error, TEXT("[DomeLightStage] Built-in semantic materials require an editor build."));
    return nullptr;
#endif
}

void UDomeLightStageCameraComponent::EnsureSemanticRegionMaterials()
{
    if (SemanticRegionMaterials.Num() > 0) return;

    struct FRegionColor { FName Region; FLinearColor Color; };
    const FRegionColor RegionColors[] = {
        { TEXT("Face"),   FLinearColor(1.0f, 0.0f, 0.0f) },
        { TEXT("Eyes"),   FLinearColor(0.0f, 1.0f, 1.0f) },
        { TEXT("Teeth"),  FLinearColor(1.0f, 1.0f, 1.0f) },
        { TEXT("Hair"),   FLinearColor(1.0f, 0.0f, 1.0f) },
        { TEXT("Torso"),  FLinearColor(0.0f, 1.0f, 0.0f) },
        { TEXT("Arms"),   FLinearColor(1.0f, 1.0f, 0.0f) },
        { TEXT("Hands"),  FLinearColor(1.0f, 0.5f, 0.0f) },
        { TEXT("Legs"),   FLinearColor(0.0f, 0.0f, 1.0f) },
        { TEXT("Feet"),   FLinearColor(0.5f, 0.0f, 1.0f) },
        { TEXT("Body"),   FLinearColor(0.0f, 0.75f, 0.25f) },
    };

    for (const FRegionColor& Entry : RegionColors)
    {
        if (UMaterialInterface* Mat = CreateSemanticColorMaterial(Entry.Region, Entry.Color))
            SemanticRegionMaterials.Add(Entry.Region, Mat);
    }
}

FName UDomeLightStageCameraComponent::GetSemanticRegionForMeshSlot(
    UMeshComponent* MeshComp, int32 MaterialIndex) const
{
    if (!MeshComp) return TEXT("Body");

    // 优先判断骨骼（比字符串名称更可靠）
    if (HasBoneName(MeshComp, TEXT("FACIAL_C_FacialRoot")))
    {
        // 这是 Face SkeletalMesh，按 slot 名细分
        const TArray<FName> SlotNames = MeshComp->GetMaterialSlotNames();
        FString SlotStr = SlotNames.IsValidIndex(MaterialIndex)
            ? SlotNames[MaterialIndex].ToString().ToLower()
            : FString();

        if (SlotStr.Contains(TEXT("eye"))  || SlotStr.Contains(TEXT("iris"))   ||
            SlotStr.Contains(TEXT("cornea"))|| SlotStr.Contains(TEXT("eyeshell")))  return TEXT("Eyes");
        if (SlotStr.Contains(TEXT("teeth"))|| SlotStr.Contains(TEXT("tongue"))  ||
            SlotStr.Contains(TEXT("saliva")))                                        return TEXT("Teeth");
        if (SlotStr.Contains(TEXT("hair")) || SlotStr.Contains(TEXT("brow"))    ||
            SlotStr.Contains(TEXT("lash")) || SlotStr.Contains(TEXT("beard")))       return TEXT("Hair");
        return TEXT("Face"); // head, lips, neck 等
    }

    if (HasBoneName(MeshComp, TEXT("spine_01")) || HasBoneName(MeshComp, TEXT("pelvis")))
    {
        // Body SkeletalMesh，按 slot 名细分
        const TArray<FName> SlotNames = MeshComp->GetMaterialSlotNames();
        FString SlotStr = SlotNames.IsValidIndex(MaterialIndex)
            ? SlotNames[MaterialIndex].ToString().ToLower()
            : FString();

        if (SlotStr.Contains(TEXT("hand"))  || SlotStr.Contains(TEXT("finger")) ||
            SlotStr.Contains(TEXT("thumb")) || SlotStr.Contains(TEXT("palm")))       return TEXT("Hands");
        if (SlotStr.Contains(TEXT("foot"))  || SlotStr.Contains(TEXT("toe"))     ||
            SlotStr.Contains(TEXT("shoe"))  || SlotStr.Contains(TEXT("boot")))       return TEXT("Feet");
        if (SlotStr.Contains(TEXT("leg"))   || SlotStr.Contains(TEXT("thigh"))   ||
            SlotStr.Contains(TEXT("calf"))  || SlotStr.Contains(TEXT("knee")))       return TEXT("Legs");
        if (SlotStr.Contains(TEXT("arm"))   || SlotStr.Contains(TEXT("elbow"))   ||
            SlotStr.Contains(TEXT("shoulder"))|| SlotStr.Contains(TEXT("wrist")))    return TEXT("Arms");
        return TEXT("Torso");
    }

    // 最后兜底：字符串匹配
    FString Key = MeshComp->GetName().ToLower();
    if (Key.Contains(TEXT("eye"))  || Key.Contains(TEXT("iris")))    return TEXT("Eyes");
    if (Key.Contains(TEXT("teeth"))|| Key.Contains(TEXT("tongue")))  return TEXT("Teeth");
    if (Key.Contains(TEXT("hair")) || Key.Contains(TEXT("brow")))    return TEXT("Hair");
    if (Key.Contains(TEXT("face")) || Key.Contains(TEXT("head")))    return TEXT("Face");
    if (Key.Contains(TEXT("hand")) || Key.Contains(TEXT("finger")))  return TEXT("Hands");
    if (Key.Contains(TEXT("arm"))  || Key.Contains(TEXT("elbow")))   return TEXT("Arms");
    if (Key.Contains(TEXT("foot")) || Key.Contains(TEXT("toe")))     return TEXT("Feet");
    if (Key.Contains(TEXT("leg"))  || Key.Contains(TEXT("thigh")))   return TEXT("Legs");
    if (Key.Contains(TEXT("torso"))|| Key.Contains(TEXT("chest")))   return TEXT("Torso");
    return TEXT("Body");
}

bool UDomeLightStageCameraComponent::IsSemanticCandidateMesh(UMeshComponent* MeshComp) const
{
    if (!MeshComp || !MeshComp->IsRegistered()) return false;

    // MetaHuman 固定骨骼命名快速判断
    if (HasBoneName(MeshComp, TEXT("FACIAL_C_FacialRoot")) ||
        HasBoneNameContaining(MeshComp, TEXT("FACIAL_"))   ||
        HasBoneName(MeshComp, TEXT("spine_01"))            ||
        HasBoneName(MeshComp, TEXT("pelvis"))              ||
        HasBoneName(MeshComp, TEXT("head")))
    {
        return true;
    }

    // 名称关键词兜底
    FString Key = MeshComp->GetName().ToLower();
    if (AActor* Owner = MeshComp->GetOwner())
    {
        Key += TEXT("_");
        Key += Owner->GetName().ToLower();
    }
    return Key.Contains(TEXT("metahuman")) || Key.Contains(TEXT("face"))  ||
           Key.Contains(TEXT("head"))      || Key.Contains(TEXT("body"))  ||
           Key.Contains(TEXT("hair"))      || Key.Contains(TEXT("groom")) ||
           Key.Contains(TEXT("eye"))       || Key.Contains(TEXT("teeth"));
}

bool UDomeLightStageCameraComponent::HasBoneName(UMeshComponent* MeshComp, const FName& BoneName) const
{
    USkeletalMeshComponent* SkelComp = Cast<USkeletalMeshComponent>(MeshComp);
    if (!SkelComp || !SkelComp->GetSkeletalMeshAsset()) return false;
    if (SkelComp->GetBoneIndex(BoneName) != INDEX_NONE) return true;
    return SkelComp->GetSkeletalMeshAsset()->GetRefSkeleton().FindBoneIndex(BoneName) != INDEX_NONE;
}

bool UDomeLightStageCameraComponent::HasBoneNameContaining(
    UMeshComponent* MeshComp, const FString& BoneNamePart) const
{
    USkeletalMeshComponent* SkelComp = Cast<USkeletalMeshComponent>(MeshComp);
    if (!SkelComp || !SkelComp->GetSkeletalMeshAsset()) return false;

    const FReferenceSkeleton& RefSkeleton = SkelComp->GetSkeletalMeshAsset()->GetRefSkeleton();
    for (int32 BoneIdx = 0; BoneIdx < RefSkeleton.GetNum(); ++BoneIdx)
    {
        if (RefSkeleton.GetBoneName(BoneIdx).ToString().Contains(BoneNamePart, ESearchCase::IgnoreCase))
            return true;
    }
    return false;
}

